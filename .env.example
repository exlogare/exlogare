# ---------------------------------------------------------------------------
# Exlogare Community Edition — environment template
# Copy to .env and fill in secrets before first `docker compose up`.
# ---------------------------------------------------------------------------

# --- Images (GHCR) -----------------------------------------------------------
IMAGE_TAG=latest

# --- Web ---------------------------------------------------------------------
WEB_PORT=8080
# Public URL for webhooks/OAuth. See README "HTTPS and PUBLIC_BASE_URL" for local, DDNS, and tunnel setups.
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:8080
APP_ENV=prod

# --- Updates (Community Edition UI) ------------------------------------------
# Set to false to disable GitHub release checks from the dashboard sidebar.
UPDATE_CHECK_ENABLED=true

# --- Database (bundled Postgres in docker-compose.yml) -------------------------
POSTGRES_USER=exlogare
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=exlogare

# --- External Postgres / Redis (optional) ------------------------------------
# Uncomment when using docker-compose.external.yml or your own managed services.
# Redis uses three logical DB indexes: 0 = app cache, 1 = Celery broker, 2 = results.
#
# DATABASE_URL=postgresql+asyncpg://user:pass@db.example.com:5432/exlogare
# SYNC_DATABASE_URL=postgresql+psycopg2://user:pass@db.example.com:5432/exlogare
# REDIS_URL=redis://:password@redis.example.com:6379/0
# CELERY_BROKER_URL=redis://:password@redis.example.com:6379/1
# CELERY_RESULT_BACKEND=redis://:password@redis.example.com:6379/2

# --- Secrets (generate with scripts/generate_secrets.sh) ---------------------
JWT_SECRET=change-me-jwt-secret
ENCRYPTION_KEY=change-me-fernet-key-base64

# --- Bootstrap admin (required on first run when users table is empty) -------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_TENANT_NAME=Default

# --- OpenID Connect / Keycloak (optional SSO login) --------------------------
# Create a confidential client with Standard flow + Valid redirect URI below.
OIDC_ENABLED=false
OIDC_ISSUER=https://keycloak.example.com/realms/exlogare
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to {PUBLIC_BASE_URL}/api/auth/oidc/callback when empty.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_AUTO_PROVISION=true
OIDC_DISPLAY_NAME=Keycloak

# --- Retention ---------------------------------------------------------------
RETENTION_DAYS=365

# --- LLM (OpenAI-compatible) -------------------------------------------------
# Prefer a local model for fully offline RCA (Ollama example — first-class CE path):
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
# Many local models do not support response_format=json_object — set false if needed.
LLM_JSON_MODE=false
LLM_TAIL_LINES=500
LLM_TOKEN_BUDGET=2500

# System prompt — bundled file works out of the box (see config/llm_system_prompt.txt).
# Override with LLM_SYSTEM_PROMPT (inline) or another path via LLM_SYSTEM_PROMPT_FILE.
# LLM_SYSTEM_PROMPT=
LLM_SYSTEM_PROMPT_FILE=config/llm_system_prompt.txt

# --- Other LLM backends ------------------------------------------------------
# OpenAI:     LLM_BASE_URL= (empty)  LLM_MODEL=gpt-4o-mini  LLM_API_KEY=sk-...  LLM_JSON_MODE=true
# vLLM:       LLM_BASE_URL=http://vllm:8000/v1  LLM_MODEL=meta-llama/...  LLM_API_KEY=local
# LM Studio:  LLM_BASE_URL=http://host.docker.internal:1234/v1  LLM_API_KEY=lm-studio
# LiteLLM:    LLM_BASE_URL=http://litellm:4000/v1
# On Linux without host.docker.internal: use http://172.17.0.1:11434/v1 (docker0 bridge).
# Compose already maps host.docker.internal → host-gateway for api/worker.
# --- GitLab OAuth (optional) -------------------------------------------------
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8080/auth/gitlab/callback
GITLAB_WEBHOOK_SECRET=

# --- GitHub OAuth (optional) -------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/github/oauth/callback

# --- Bitbucket OAuth (optional) ----------------------------------------------
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=
BITBUCKET_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/bitbucket/oauth/callback
BITBUCKET_WEBHOOK_SECRET=

# --- GitFlic OAuth (optional) --------------------------------------------------
GITFLIC_OAUTH_CLIENT_ID=
GITFLIC_OAUTH_CLIENT_SECRET=
GITFLIC_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/gitflic/oauth/callback
GITFLIC_WEBHOOK_SECRET=

# --- Email (optional, for contact form notifications) ------------------------
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_EMAIL=admin@example.com
SUPPORT_EMAIL=admin@example.com
COMPANY_NAME=Exlogare

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
