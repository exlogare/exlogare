# syntax=docker/dockerfile:1.7
# Community Edition API + Celery image (api, worker, beat share this build).

ARG PYTHON_VERSION=3.11
ARG VERSION=1.0.0
ARG VCS_REF=unknown
ARG BUILD_DATE=

FROM python:${PYTHON_VERSION}-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml ./
COPY app ./app

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python .

FROM python:${PYTHON_VERSION}-slim AS runtime

ARG VERSION=1.0.0
ARG VCS_REF=unknown
ARG BUILD_DATE=

LABEL org.opencontainers.image.title="Exlogare Community Edition API" \
      org.opencontainers.image.description="FastAPI backend and Celery workers for Exlogare Community Edition" \
      org.opencontainers.image.url="https://exlogare.net" \
      org.opencontainers.image.source="https://github.com/exlogare/exlogare" \
      org.opencontainers.image.documentation="https://exlogare.net/docs" \
      org.opencontainers.image.vendor="Exlogare" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      io.exlogare.edition="community" \
      io.exlogare.component="api"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV="/opt/venv" \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY app ./app
COPY config ./config
COPY scripts ./scripts

RUN chmod +x /app/scripts/entrypoint-api.sh \
    && chown -R app:app /app /opt/venv

USER app

EXPOSE 8000

ENV HEALTHCHECK_HOST=localhost
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS -H "Host: ${HEALTHCHECK_HOST}" http://127.0.0.1:8000/healthz || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/app/scripts/entrypoint-api.sh"]
CMD ["gunicorn", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "-w", "3", \
     "-b", "0.0.0.0:8000", \
     "--forwarded-allow-ips=*", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--timeout", "60", \
     "--graceful-timeout", "30", \
     "app.main:app"]
